# 青禾智灌智慧灌溉管理平台 —— 环境变量样例
# 用法：复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会入库）
#   copy .env.example .env
# 也可运行 python tools/gen_secret.py 自动生成随机密钥并写入 .env

# ---------------------------------------------------------------------------
# 安全
# ---------------------------------------------------------------------------
# Flask 会话 / JWT 签名密钥。**必须**改成随机长字符串，切勿使用默认值。
# 生成方式：python tools/gen_secret.py   （内部使用 secrets.token_urlsafe(48)）
FARM_SECRET_KEY=CHANGE_ME_replace_with_random_string

# ---------------------------------------------------------------------------
# 存储
# ---------------------------------------------------------------------------
# SQLite 数据库文件路径。相对路径以项目根目录为基准；不填则用 qinghe.db
FARM_DB_PATH=qinghe.db

# ---------------------------------------------------------------------------
# 监听（校园网部署关键项）
# ---------------------------------------------------------------------------
# 监听地址。0.0.0.0 = 监听所有网卡（别人才能访问）；127.0.0.1 = 仅本机
HOST=0.0.0.0
# 监听端口。校园网内其他人访问 http://<你的校园网IP>:<PORT>
PORT=5000

# ---------------------------------------------------------------------------
# 调试
# ---------------------------------------------------------------------------
# 调试开关。0 = 生产模式（对外开放必须为 0，否则调试器可被远程利用）
# 1 = 开发调试（会暴露 Werkzeug 调试器，仅限本机自用）
FARM_DEBUG=0
